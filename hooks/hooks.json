{
  "description": "ultraguard: per-agent delegation gate for Workflow scripts, plus the delegation policy as session context",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session.mjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs\"", "timeout": 15, "onFailure": "block" }
        ]
      }
    ]
  },
  "modules": ["./eval.tsx"]
}
